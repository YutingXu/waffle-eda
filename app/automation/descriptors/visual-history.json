{
  "feature": "visualHistory",
  "title": "Visual History",
  "mcpAdapter": true,
  "modules": {
    "editor": [
      "AtriumHistorySession"
    ],
    "mcp": [
      "butter-visual-history"
    ]
  },
  "commands": [
    {
      "id": "session-open",
      "title": "Open a private MCP history session",
      "kind": "state",
      "properties": {},
      "required": [],
      "surfaces": [
        "mcp"
      ]
    },
    {
      "id": "session-close",
      "title": "Close the private MCP history session",
      "kind": "state",
      "properties": {},
      "required": [],
      "surfaces": [
        "mcp"
      ]
    },
    {
      "id": "record-edit",
      "title": "Record a checked edit in visual history",
      "kind": "state",
      "properties": {
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "enum": [
                  "set",
                  "add",
                  "remove"
                ]
              },
              "target": {
                "enum": [
                  "project",
                  "document",
                  "item",
                  "library"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "document": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "before": {},
              "after": {},
              "value": {
                "type": "object"
              },
              "after_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "op",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "ops",
        "label"
      ]
    },
    {
      "id": "undo",
      "title": "Undo a session edit",
      "kind": "state",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": []
    },
    {
      "id": "redo",
      "title": "Redo a session edit",
      "kind": "state",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": []
    },
    {
      "id": "session-list",
      "title": "List session edits and branches",
      "kind": "read",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": []
    },
    {
      "id": "session-preview",
      "title": "Preview a session history step",
      "kind": "read",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9]{1,16}$"
        }
      },
      "required": []
    },
    {
      "id": "session-compare",
      "title": "Compare a session step with the current design",
      "kind": "read",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9]{1,16}$"
        }
      },
      "required": [
        "step"
      ]
    },
    {
      "id": "session-thumbnail",
      "title": "Get touched geometry for an edit thumbnail",
      "kind": "read",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9]{1,16}$"
        }
      },
      "required": [
        "step"
      ]
    },
    {
      "id": "session-restore",
      "title": "Restore a reviewed history step",
      "kind": "state",
      "properties": {
        "receipt": {
          "type": "string",
          "pattern": "^[0-9]{1,16}$"
        }
      },
      "required": [
        "receipt"
      ]
    },
    {
      "id": "session-fork",
      "title": "Fork at a reviewed history step",
      "kind": "state",
      "properties": {
        "receipt": {
          "type": "string",
          "pattern": "^[0-9]{1,16}$"
        }
      },
      "required": [
        "receipt"
      ]
    },
    {
      "id": "clipboard-list",
      "title": "Search the private clipboard",
      "kind": "read",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "query": {
          "type": "string",
          "maxLength": 256
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": []
    },
    {
      "id": "clipboard-copy",
      "title": "Copy design objects into the private clipboard",
      "kind": "state",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "itemIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": []
    },
    {
      "id": "clipboard-text",
      "title": "Copy plain text or mathematics into the private clipboard",
      "kind": "state",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "kind": {
          "enum": [
            "schematic",
            "pcb"
          ]
        },
        "math": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ]
    },
    {
      "id": "clipboard-preview",
      "title": "Preview a private clipboard entry",
      "kind": "read",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "entry"
      ]
    },
    {
      "id": "clipboard-pin",
      "title": "Pin or unpin a clipboard entry",
      "kind": "state",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "entry",
        "on"
      ]
    },
    {
      "id": "clipboard-rename",
      "title": "Rename a clipboard entry or snippet",
      "kind": "state",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "entry",
        "name"
      ]
    },
    {
      "id": "clipboard-remove",
      "title": "Remove a clipboard entry",
      "kind": "state",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "entry"
      ]
    },
    {
      "id": "clipboard-clear",
      "title": "Clear unpinned clipboard entries",
      "kind": "state",
      "properties": {},
      "required": []
    },
    {
      "id": "clipboard-paste",
      "title": "Paste a clipboard entry as one edit",
      "kind": "state",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "entry",
        "x",
        "y"
      ]
    },
    {
      "id": "git-list",
      "title": "List Git commits in visual history",
      "kind": "read",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [],
      "mcpAdapter": true
    },
    {
      "id": "git-preview",
      "title": "Preview a committed design",
      "kind": "read",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "revision"
      ],
      "mcpAdapter": true
    },
    {
      "id": "git-compare",
      "title": "Compare a committed design with the current design",
      "kind": "read",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "revision"
      ],
      "mcpAdapter": true
    },
    {
      "id": "git-branch",
      "title": "Create a local Git branch at a commit",
      "kind": "state",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "confirm": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "name",
        "confirm"
      ],
      "mcpAdapter": true
    }
  ]
}
