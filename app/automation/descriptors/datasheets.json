      "kind": "read",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "region": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 4,
          "maxItems": 4
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      },
      "required": [
        "id",
        "page"
      ],
      "mcpAdapter": true,
      "modules": {
        "editor": [
          "AtriumDatasheets"
        ]
      },
      "surfaces": [
        "editor",
        "mcp"
      ]
    },
    {
      "id": "search",
      "title": "Search Datasheet Text",
      "kind": "read",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "id",
        "query"
      ],
      "mcpAdapter": true,
      "modules": {
        "editor": [
          "AtriumDatasheets"
        ]
      },
      "surfaces": [
        "editor",
        "mcp"
      ]
    },
    {
      "id": "pin-table",
