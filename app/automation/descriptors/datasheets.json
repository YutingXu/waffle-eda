        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "region": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "minItems": 4,
          "maxItems": 4
        },
        "side": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
