{
  "feature": "numericFields",
  "title": "Numeric fields",
  "mcpAdapter": true,
  "modules": {
    "editor": ["AtriumNumericFields", "AtriumCalculations", "AtriumCalc", "AtriumRules", "AtriumViaStack"],
    "mcp": ["numeric-fields"]
  },
  "commands": [
    {
      "id": "evaluate",
      "title": "Evaluate a numeric field",
      "kind": "read",
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 0, "maxLength": 32768},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "documentId", "path"],
          "properties": {
            "scope": {"type": "string", "enum": ["item", "document", "rule"]},
            "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
            "itemId": {"type": "string", "minLength": 1, "maxLength": 128},
            "ruleId": {"type": "string", "minLength": 1, "maxLength": 128},
            "path": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {
                "type": ["string", "object"], "minLength": 1, "maxLength": 128,
                "additionalProperties": false, "required": ["id"],
                "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
              }
            }
          }
        },
        "unit": {"type": "string", "minLength": 0, "maxLength": 40},
        "storageUnit": {"type": "string", "minLength": 0, "maxLength": 40},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "integer": {"type": "boolean"},
        "optional": {"type": "boolean"}
      }
    },
    {
      "id": "inspect",
      "title": "Inspect a numeric field and its binding",
      "kind": "read",
      "required": ["target"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "documentId", "path"],
          "properties": {
            "scope": {"type": "string", "enum": ["item", "document", "rule"]},
            "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
            "itemId": {"type": "string", "minLength": 1, "maxLength": 128},
            "ruleId": {"type": "string", "minLength": 1, "maxLength": 128},
            "path": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {
                "type": ["string", "object"], "minLength": 1, "maxLength": 128,
                "additionalProperties": false, "required": ["id"],
                "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
              }
            }
          }
        }
      }
    },
    {
      "id": "set",
      "title": "Set a numeric field from an expression",
      "kind": "edit",
      "required": ["target", "source"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "documentId", "path"],
          "properties": {
            "scope": {"type": "string", "enum": ["item", "document", "rule"]},
            "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
            "itemId": {"type": "string", "minLength": 1, "maxLength": 128},
            "ruleId": {"type": "string", "minLength": 1, "maxLength": 128},
            "path": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {
                "type": ["string", "object"], "minLength": 1, "maxLength": 128,
                "additionalProperties": false, "required": ["id"],
                "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
              }
            }
          }
        },
        "source": {"type": "string", "minLength": 0, "maxLength": 32768}
      }
    },
    {
      "id": "clear",
      "title": "Clear a numeric field binding",
      "kind": "edit",
      "required": ["target"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "documentId", "path"],
          "properties": {
            "scope": {"type": "string", "enum": ["item", "document", "rule"]},
            "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
            "itemId": {"type": "string", "minLength": 1, "maxLength": 128},
            "ruleId": {"type": "string", "minLength": 1, "maxLength": 128},
            "path": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {
                "type": ["string", "object"], "minLength": 1, "maxLength": 128,
                "additionalProperties": false, "required": ["id"],
                "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
              }
            }
          }
        }
      }
    }
  ]
}
