{
  "feature": "savedViews",
  "title": "Saved Views",
  "editorActions": [
    {"id":"panel","title":"Saved Views Panel","module":"AtriumViewsPanel"},
    {"id":"capture-current","title":"Save Current View","module":"AtriumViewsPanel"}
  ],
  "modules": {
    "editor": ["AtriumSavedViews"],
    "mcp": ["saved-views"]
  },
  "commands": [
    {
      "id": "list",
      "title": "List Saved Views",
      "kind": "read",
      "properties": {
        "offset": {"type":"integer", "minimum":0, "maximum":128},
        "limit": {"type":"integer", "minimum":1, "maximum":128}
      },
      "required": []
    },
    {
      "id": "capture",
      "title": "Capture Saved View",
      "kind": "edit",
      "properties": {
        "name": {"type":"string", "minLength":1, "maxLength":200},
        "view": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentId", "camera", "viewport"],
          "properties": {
            "documentId": {"type":"string", "minLength":1, "maxLength":512},
            "camera": {
              "type": "object",
              "additionalProperties": false,
              "required": ["center", "scale", "referenceScale", "flipped", "rotationRadians"],
              "properties": {
                "center": {"type":"array", "minItems":2, "maxItems":2, "items":{"type":"number", "minimum":-1000000000, "maximum":1000000000}},
                "scale": {"type":"number", "minimum":1e-9, "maximum":1000000},
                "referenceScale": {"type":"number", "minimum":1e-9, "maximum":1000000},
                "flipped": {"type":"boolean"},
                "rotationRadians": {"type":"number", "minimum":-3.141592653589793, "maximum":3.141592653589793}
              }
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pixelWidth", "pixelHeight"],
              "properties": {
                "pixelWidth": {"type":"integer", "minimum":1, "maximum":32768},
                "pixelHeight": {"type":"integer", "minimum":1, "maximum":32768}
              }
            },
            "layers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hidden", "active", "mode"],
              "properties": {
                "hidden": {"type":"array", "maxItems":4096, "uniqueItems":true, "items":{"type":"string", "minLength":1, "maxLength":512}},
                "active": {"type":"string", "minLength":1, "maxLength":512},
                "mode": {"type":"string", "enum":["all", "dim", "single"]}
              }
            },
            "selection": {"type":"array", "maxItems":10000, "uniqueItems":true, "items":{"type":"string", "minLength":1, "maxLength":512}},
            "netHighlight": {"type":"string", "minLength":1, "maxLength":512},
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "mask", "highlight"],
              "properties": {
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "languageVersion": {"type":"integer", "enum":[1]},
                    "source": {"type":"string", "minLength":1, "maxLength":2000},
                    "bindings": {"type":"array", "maxItems":600, "items":{"type":"object"}},
                    "savedQueryId": {"type":"string", "minLength":36, "maxLength":36}
                  }
                },
                "mask": {"type":"boolean"},
                "highlight": {"type":"boolean"}
              }
            }
          }
        }
      },
      "required": ["name"]
    },
    {
      "id": "rename",
      "title": "Rename Saved View",
      "kind": "edit",
      "properties": {
        "id": {"type":"string", "minLength":36, "maxLength":36},
        "name": {"type":"string", "minLength":1, "maxLength":200}
      },
      "required": ["id", "name"]
    },
    {
      "id": "remove",
      "title": "Remove Saved View",
      "kind": "edit",
      "properties": {"id":{"type":"string", "minLength":36, "maxLength":36}},
      "required": ["id"]
    },
    {
      "id": "apply",
      "title": "Apply Saved View",
      "kind": "state",
      "editorTransition":true,
      "modules": {"mcp":["drawing", "query", "butter-query-service"]},
      "properties": {"id":{"type":"string", "minLength":36, "maxLength":36}},
      "required": ["id"]
    },
    {
      "id": "present",
      "title": "Start Saved View Sequence",
      "kind": "state",
      "editorMode": "write",
      "editorTransition":true,
      "modules": {"mcp":["drawing", "query", "butter-query-service"]},
      "properties": {
        "ids": {"type":"array", "maxItems":128, "uniqueItems":true, "items":{"type":"string", "minLength":36, "maxLength":36}},
        "index": {"type":"integer", "minimum":0, "maximum":127}
      },
      "required": []
    },
    {
      "id": "step",
      "title": "Step Through Saved Views",
      "kind": "state",
      "editorMode": "write",
      "editorTransition":true,
      "modules": {"mcp":["drawing", "query", "butter-query-service"]},
      "properties": {
        "ids": {"type":"array", "maxItems":128, "uniqueItems":true, "items":{"type":"string", "minLength":36, "maxLength":36}},
        "index": {"type":"integer", "minimum":0, "maximum":127},
        "direction": {"type":"integer", "enum":[-1, 1]}
      },
      "required": []
    },
    {
      "id": "export-pdf",
      "title": "Export Saved Views as PDF",
      "kind": "output",
      "outputKind": "saved-views",
      "modules": {
        "editor": ["AtriumPrint", "AtriumDrawing", "AtriumPanel", "AtriumCanvasInput", "AtriumLinkRecord", "AtriumQuery"],
        "mcp": ["print", "drawing", "panel", "canvas-input", "link-record", "query", "butter-query-service"]
      },
      "properties": {
        "ids": {"type":"array", "minItems":1, "maxItems":128, "uniqueItems":true, "items":{"type":"string", "minLength":36, "maxLength":36}},
        "color": {"type":"string", "enum":["color", "grey", "mono"]}
      },
      "required": []
    }
  ]
}
