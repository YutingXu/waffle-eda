{
  "feature": "drop",
  "title": "Drag and Drop",
  "mcpAdapter": true,
  "commands": [
    {
      "id": "inspect",
      "title": "Inspect Drop",
      "kind": "read",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "documentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "ownerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 268435456
                  },
                  "mime": {
                    "type": "string",
                    "maxLength": 127
                  }
                },
                "required": [
                  "name",
                  "size"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "point": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "target"
      ],
      "modules": {
        "editor": [
          "AtriumDrop"
        ],
        "mcp": [
          "drop-receiver"
        ]
      }
    },
    {
      "id": "open-design",
      "title": "Open Dropped Design",
      "kind": "read",
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [],
      "surfaces": [
        "mcp"
      ],
      "mcpAdapter": true
    },
    {
      "id": "place-library",
      "title": "Place Library Component",
      "kind": "edit",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "definitionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "documentId",
        "definitionId",
        "x",
        "y"
      ]
    },
    {
      "id": "scope-rule",
