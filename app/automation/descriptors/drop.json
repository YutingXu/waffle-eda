          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "netId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "documentId",
        "ruleId",
        "netId"
      ],
      "modules": {
        "editor": [
          "AtriumRules"
        ],
        "mcp": [
          "rules"
        ]
      }
    },
    {
      "id": "resolve-result",
      "title": "Resolve Dropped Result",
      "kind": "read",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
