          "maxLength": 200
        }
      },
      "required": [],
      "modules": {
        "editor": [
          "AtriumLinksDesktop"
        ],
        "mcp": [
          "links"
        ]
      }
    },
    {
      "id": "export-bom",
      "title": "Export Dropped BOM",
      "kind": "output",
      "properties": {
        "view": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "titleBlock": {
          "type": "boolean"
        }
      },
      "required": [],
      "modules": {
        "editor": [
          "AtriumBOM"
        ],
        "mcp": [
          "bom"
        ]
      },
      "outputKind": "bom"
    },
    {
      "id": "export-frame",
      "title": "Export Dropped Frame",
      "kind": "output",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "documentId",
        "frameId"
      ],
      "modules": {
        "editor": [
          "AtriumPrint",
          "AtriumSavedViews"
        ],
        "mcp": [
          "print",
          "saved-views"
        ]
      },
      "outputKind": "pdf"
    },
    {
      "id": "export-selection",
      "title": "Export Dragged Selection",
      "kind": "output",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "objectIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "svg",
            "link",
            "png"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 3200
        }
      },
      "required": [],
      "modules": {
        "editor": [
          "AtriumPrint",
          "AtriumLinksDesktop"
        ],
        "mcp": [
          "print",
          "links"
        ]
      },
      "outputKind": "selection"
    },
    {
