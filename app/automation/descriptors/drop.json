          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "calculationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "partDocumentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "partId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
