          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "partId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "documentId",
        "partId",
