    "extensions": [".gbr", ".gtl", ".gbl", ".gts", ".gbs", ".gtp", ".gbp", ".gto", ".gbo", ".gko", ".gm1"],
    "modules": {"export": ["translator-precision", "fab-outputs", "variants", "bom", "rigid-flex", "viastack", "panel"]}
  },
  {
    "id": "excellon", "label": "Excellon NC drill", "import": false, "export": true,
    "adapter": {"export": "manufacturing"},
    "extensions": [".drl", ".xln"], "modules": {"export": ["fab-outputs", "variants", "bom", "rigid-flex", "viastack", "panel"]}
  },
  {
    "id": "fabrication", "label": "Fabrication outputs", "import": false, "export": true,
    "adapter": {"export": "manufacturing"},
    "extensions": [".zip"], "modules": {"export": ["translator-precision", "fab-outputs", "variants", "bom", "rigid-flex", "viastack", "panel"]}
  },
  {
    "id": "ipc2581", "label": "IPC-2581 revision B", "import": false, "export": true,
    "adapter": {"export": "manufacturing"},
    "extensions": [".xml"], "modules": {"export": ["ipc2581", "variants", "bom", "rigid-flex", "viastack", "impedance", "panel"]}
  },
  {
    "id": "odb", "label": "ODB++ Design 8.1", "import": false, "export": true,
    "adapter": {"export": "manufacturing"},
    "extensions": [".odb", ".tgz"], "modules": {"export": ["odb", "translator-precision"]}
  },
  {
    "id": "waffle-library", "label": "Waffle component library", "import": true, "export": true,
    "adapter": {"import": "exchange", "export": "exchange"},
    "extensions": [".atrlib"], "libraryExtensions": [".atrlib"], "modules": {"import": ["library", "source-file"], "export": ["library"]}
  },
  {
    "id": "netlist-kicad", "label": "KiCad netlist", "import": true, "export": true,
    "adapter": {"import": "exchange", "export": "exchange"},
    "extensions": [".net", ".txt"], "modules": {"import": ["netlist", "source-file"], "export": ["netlist", "multichannel", "erc"]}
  },
  {
    "id": "netlist-protel", "label": "Protel netlist", "import": true, "export": true,
    "adapter": {"import": "exchange", "export": "exchange"},
    "extensions": [".net", ".frp", ".txt"], "modules": {"import": ["netlist", "source-file"], "export": ["netlist", "multichannel"]}
  },
  {
    "id": "netlist-csv", "label": "CSV netlist", "import": true, "export": true,
    "adapter": {"import": "exchange", "export": "exchange"},
    "extensions": [".csv", ".txt"], "modules": {"import": ["netlist", "source-file"], "export": ["netlist", "multichannel"]}
  }
]
