[
  {
    "id": "altium", "label": "Altium Designer", "import": true, "export": true,
    "adapter": {"import": "design", "export": "exchange"},
    "extensions": [".prjpcb", ".schdoc", ".pcbdoc", ".schlib", ".pcblib"],
    "projectExtensions": [".prjpcb"], "libraryExtensions": [".schlib", ".pcblib"],
    "group": "design", "companions": ["step"],
    "modules": {"import": ["import-formats", "import-rules"], "export": ["translator-precision", "altium-export", "library-store", "polygon-pour"]}
  },
  {
    "id": "altium-source-copy", "label": "Altium binary source copy", "requiresOriginal": true, "import": false, "export": true,
    "adapter": {"export": "exchange"},
    "extensions": [".schdoc", ".pcbdoc"], "modules": {"export": ["translator-precision", "source-copy", "polygon-pour"]}
  },
  {
    "id": "kicad", "label": "KiCad", "import": true, "export": true,
    "adapter": {"import": "design", "export": "exchange"},
    "extensions": [".kicad_pro", ".kicad_sch", ".kicad_pcb", ".kicad_dru", ".kicad_sym", ".kicad_mod"],
    "projectExtensions": [".kicad_pro"], "libraryExtensions": [".kicad_sym", ".kicad_mod"],
    "group": "design", "modules": {"import": ["import-formats"], "export": ["translator-precision", "kicad-schematic", "polygon-pour"]}
  },
  {
    "id": "eagle", "label": "Eagle XML", "import": true, "export": true,
    "adapter": {"import": "design", "export": "exchange"},
    "extensions": [".sch", ".brd"], "group": "design",
    "modules": {"import": ["import-formats"], "export": ["export-eagle"]}
  },
  {
    "id": "easyeda", "label": "EasyEDA Standard and Pro", "import": true, "export": true,
    "adapter": {"import": "design", "export": "exchange"},
    "extensions": [".json", ".epro", ".esch", ".epcb", ".eprj"], "group": "design",
    "modules": {"import": ["import-formats"], "export": ["export-easyeda"]}
  },
  {
    "id": "step", "label": "STEP mechanical model", "import": true, "export": true,
    "adapter": {"import": "manufacturing", "export": "manufacturing"},
    "extensions": [".step", ".stp"],
    "modules": {"import": ["model", "step-import", "mcad-step", "source-file"], "export": ["step-export", "variants", "bom", "viastack", "panel"]}
  },
  {
    "id": "idf", "label": "IDF mechanical exchange", "import": true, "export": true,
    "adapter": {"import": "manufacturing", "export": "manufacturing"},
    "extensions": [".emn", ".idf", ".emp", ".brd"], "modules": {"import": ["mcad-idf", "source-file"], "export": ["mcad-idf"]}
  },
  {
    "id": "dxf", "label": "DXF board geometry", "import": true, "export": true,
    "adapter": {"import": "manufacturing", "export": "manufacturing"},
    "extensions": [".dxf"], "modules": {"import": ["dxf", "board-shape-sources", "source-file"], "export": ["dxf", "pcb-draw", "pcb-text", "pcb-appearance"]}
  },
  {
    "id": "idx", "label": "IDX mechanical exchange", "import": true, "export": true,
    "adapter": {"import": "manufacturing", "export": "manufacturing"},
    "extensions": [".idx", ".xml"], "modules": {"import": ["mcad-idx", "source-file"], "export": ["mcad-idx"]}
  },
  {
    "id": "glb", "label": "Binary glTF model", "import": false, "export": true,
    "adapter": {"export": "manufacturing"},
    "extensions": [".glb"], "modules": {"export": ["step-export", "variants", "bom", "viastack", "panel"]}
  },
  {
    "id": "gerber", "label": "Gerber artwork", "import": false, "export": true,
