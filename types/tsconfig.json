{
  // Type checking without a build step (docs/typing.md). Run scripts/typecheck.sh, not tsc directly:
  // it adds the generated module member lists and checks that "files" matches types/baseline.json.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    // Check our own .d.ts files: the generated export checks (types/gen-globals.py) live in one.
    "skipLibCheck": false,
    "strict": true,
    // Off: without annotations, strict null checks type `[]` as never[] and `let x = null` as null,
    // which made over 90% of the reports false (1,265 vs 121 on the first 30 modules). Typed code
    // still gets the null-aware .d.ts signatures; see docs/typing.md for the planned strict tier.
    "strictNullChecks": false,
    // Eager modules may not carry JSDoc (every byte counts against the startup budget), so their
    // parameters stay untyped; the hand-written .d.ts files type the module boundaries instead.
    "noImplicitAny": false,
    // `catch (e) { ... e.message }` is the house style; an Error is what every throw site throws.
    "useUnknownInCatchVariables": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true
  },
