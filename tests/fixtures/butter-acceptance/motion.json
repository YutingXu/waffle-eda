{
  "cases": {
    "policy": {
      "args": {"requested": "full", "osReduced": true, "visibility": "occluded", "pointerHover": true},
      "expect": {"changes": 0, "opacity": true, "suspended": true, "travel": false, "hover": false},
      "expectPaths": {"untrusted_design_text.level": "reduced"}
    },
    "plan": {
      "args": {"kind": "camera", "duration": "slow", "visibility": "hidden"},
      "expect": {"changes": 0, "durationMs": 320},
      "expectPaths": {"untrusted_design_text.disposition": "paused"}
    },
    "sample": {
      "args": {"from": 0, "to": 80, "elapsedMs": 50, "durationMs": 200, "curve": "linear"},
      "expect": {"changes": 0, "value": 20, "progress": 0.25, "finished": false}
    },
    "retarget": {
      "args": {"from": 0, "previousTarget": 80, "to": -40, "elapsedMs": 50, "durationMs": 200, "nextDurationMs": 140, "curve": "linear"},
      "expect": {"changes": 0, "from": 20, "to": -40, "durationMs": 140},
      "expectPaths": {"untrusted_design_text.previous.value": 20}
    }
  }
}
