<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- Synthetic Eagle 9 board written for Atrium's importer tests. -->
<eagle version="9.6.2">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
</settings>
<grid distance="0.05" unitdist="inch" unit="inch" style="lines" multiple="1" display="no" altdistance="0.025" altunitdist="inch" altunit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="2" name="Route2" color="16" fill="1" visible="yes" active="yes"/>
<layer number="15" name="Route15" color="23" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="24" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="50" y2="0" width="0" layer="20"/>
<wire x1="50" y1="0" x2="50" y2="30" width="0" layer="20"/>
<wire x1="50" y1="30" x2="10" y2="30" width="0" layer="20"/>
<wire x1="10" y1="30" x2="0" y2="20" width="0" layer="20" curve="90"/>
<wire x1="0" y1="20" x2="0" y2="0" width="0" layer="20"/>
<circle x="25" y="15" radius="3" width="0" layer="20"/>
<hole x="45" y="25" drill="3.2"/>
<text x="5" y="5" size="1.27" layer="21">ATRIUM</text>
</plain>
<libraries>
<library name="atrium-test">
<packages>
<package name="R0603">
<smd name="1" x="-0.8" y="0" dx="0.9" dy="0.9" layer="1" roundness="25"/>
<smd name="2" x="0.8" y="0" dx="0.9" dy="0.9" layer="1" roundness="25"/>
<wire x1="-1.5" y1="0.7" x2="1.5" y2="0.7" width="0.127" layer="21"/>
<wire x1="-0.8" y1="-0.4" x2="0.8" y2="-0.4" width="0.1" layer="51"/>
<text x="-1" y="1" size="1" layer="25">&gt;NAME</text>
</package>
<package name="HDR2">
<pad name="1" x="0" y="0" drill="1" shape="square"/>
<pad name="2" x="2.54" y="0" drill="1"/>
<wire x1="-1.27" y1="1.27" x2="3.81" y2="1.27" width="0.127" layer="21"/>
</package>
</packages>
</library>
</libraries>
<classes>
<class number="0" name="default" width="0" drill="0">
<clearance class="0" value="0"/>
</class>
<class number="1" name="power" width="0.5" drill="0.4">
<clearance class="1" value="0.3"/>
</class>
</classes>
<designrules name="default">
<param name="layerSetup" value="(1*2*15*16)"/>
<param name="mdWireWire" value="8mil"/>
<param name="msWidth" value="10mil"/>
<param name="msDrill" value="0.35mm"/>
<param name="rvPadTop" value="0.25"/>
<param name="rlMinPadTop" value="10mil"/>
<param name="rlMaxPadTop" value="20mil"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rlMinViaOuter" value="8mil"/>
<param name="rlMaxViaOuter" value="20mil"/>
</designrules>
<autorouter>
</autorouter>
<elements>
<element name="R1" library="atrium-test" package="R0603" value="10k" x="20" y="10" rot="R90"/>
<element name="J1" library="atrium-test" package="HDR2" value="" x="35" y="10" rot="MR0"/>
</elements>
<signals>
<signal name="SIG">
<contactref element="R1" pad="1"/>
<contactref element="J1" pad="1"/>
<wire x1="20" y1="9.2" x2="20" y2="5" width="0.254" layer="1"/>
<wire x1="20" y1="5" x2="35" y2="5" width="0.254" layer="16"/>
<wire x1="35" y1="5" x2="35" y2="10" width="0.254" layer="2"/>
<via x="20" y="5" extent="1-16" drill="0.4"/>
<via x="35" y="5" extent="1-2" drill="0.3" diameter="0.6"/>
</signal>
<signal name="GND" class="1">
<contactref element="R1" pad="2"/>
<contactref element="J1" pad="2"/>
<polygon width="0.254" layer="16" isolate="0.4" rank="1" orphans="no">
<vertex x="1" y="1"/>
<vertex x="49" y="1"/>
<vertex x="49" y="29"/>
<vertex x="1" y="29"/>
</polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
