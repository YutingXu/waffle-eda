<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- Census fixture, written by hand from the structure of the public eagle.dtd. A small board that
     sets, wherever it can, a value other than Eagle's default, so that a property the importer does
     not read shows up in tests/e2e/census-eagle.cjs. Mirrored elements use MR0 or MR180 only, where
     Eagle's rotate-then-mirror and mirror-then-rotate orders agree. -->
<eagle version="9.6.2">
<compatibility>
<note version="9.0" severity="warning">Census note: written for the census, not by Eagle.</note>
</compatibility>
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.635" unitdist="mm" unit="mm" style="dots" multiple="2" display="yes" altdistance="0.127" altunitdist="mm" altunit="mm"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="2" name="Route2" color="16" fill="1" visible="yes" active="yes"/>
<layer number="15" name="Route15" color="23" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="24" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="27" name="tValues" color="7" fill="1" visible="yes" active="yes"/>
<layer number="29" name="tStop" color="7" fill="3" visible="no" active="yes"/>
<layer number="31" name="tCream" color="7" fill="4" visible="no" active="yes"/>
<layer number="39" name="tKeepout" color="4" fill="11" visible="yes" active="yes"/>
<layer number="41" name="tRestrict" color="4" fill="10" visible="yes" active="yes"/>
<layer number="42" name="bRestrict" color="1" fill="10" visible="yes" active="yes"/>
<layer number="43" name="vRestrict" color="2" fill="10" visible="yes" active="yes"/>
<layer number="46" name="Milling" color="3" fill="1" visible="yes" active="yes"/>
<layer number="47" name="Measures" color="7" fill="1" visible="yes" active="yes"/>
<layer number="48" name="Document" color="7" fill="1" visible="yes" active="yes"/>
<layer number="51" name="tDocu" color="7" fill="1" visible="yes" active="yes"/>
<layer number="101" name="Logo" color="13" fill="1" visible="no" active="yes"/>
</layers>
<board>
<description language="en">Census board: a small sensor carrier.</description>
<plain>
<wire x1="0" y1="0" x2="40" y2="0" width="0" layer="20"/>
<wire x1="40" y1="0" x2="40" y2="30" width="0" layer="20"/>
<wire x1="40" y1="30" x2="5" y2="30" width="0" layer="20"/>
<wire x1="5" y1="30" x2="0" y2="25" width="0" layer="20" curve="90"/>
<wire x1="0" y1="25" x2="0" y2="0" width="0" layer="20"/>
<circle x="8" y="8" radius="1.5" width="0" layer="20"/>
<wire x1="34" y1="10" x2="34" y2="16" width="1" layer="46"/>
<hole x="36" y="26" drill="3.2"/>
<text x="5" y="3" size="1.5" layer="21" font="vector" ratio="15" rot="R90" align="center">CENSUS</text>
<text x="35" y="3" size="1.2" layer="22" font="proportional" ratio="8" rot="MR0" align="bottom-right" distance="80">BOTTOM
TWO LINES</text>
<text x="30" y="28.5" size="1" layer="101">LOGO</text>
<wire x1="2" y1="28" x2="12" y2="28" width="0.2" layer="21" style="longdash"/>
<wire x1="2" y1="26" x2="8" y2="26" width="0.3" layer="21" curve="-45" cap="flat"/>
<wire x1="28" y1="29" x2="33" y2="29" width="0.2" layer="101"/>
<circle x="20" y="27" radius="1" width="0" layer="21"/>
<circle x="24" y="27" radius="1" width="0.2" layer="51"/>
<rectangle x1="26" y1="25" x2="28" y2="27" layer="21" rot="R45"/>
<rectangle x1="14" y1="2" x2="18" y2="6" layer="41"/>
<rectangle x1="16" y1="8" x2="18" y2="10" layer="42"/>
<rectangle x1="20" y1="2" x2="22" y2="4" layer="43"/>
<polygon width="0.3" layer="16" pour="cutout">
<vertex x="30" y="16"/>
<vertex x="36" y="16"/>
<vertex x="36" y="20"/>
<vertex x="30" y="20"/>
</polygon>
<polygon width="0.254" layer="1" isolate="0.5" thermals="no" orphans="yes" rank="3">
<vertex x="28" y="26"/>
<vertex x="32" y="26"/>
<vertex x="32" y="28"/>
<vertex x="28" y="28"/>
</polygon>
<polygon width="0.2" layer="21">
<vertex x="14" y="26"/>
<vertex x="18" y="26" curve="60"/>
<vertex x="16" y="28.5"/>
</polygon>
<dimension x1="0" y1="-2" x2="40" y2="-2" x3="20" y3="-4" textsize="1" textratio="8" layer="47" dtype="horizontal" width="0.13" extwidth="0.1" extlength="1" extoffset="0.5" unit="mm" precision="2" visible="yes"/>
<frame x1="-5" y1="-8" x2="45" y2="35" columns="4" rows="3" layer="48" border-left="no"/>
</plain>
<libraries>
<library name="census-lib" urn="urn:adsk.eagle:library:900001">
<description>Census library: parts written for the census.</description>
<packages>
<package name="QFN-CENSUS" urn="urn:adsk.eagle:footprint:900002/1" library_version="3" locally_modified="yes">
<description>Census QFN with an exposed pad and a bottom pad.</description>
<smd name="1" x="-1.5" y="0.5" dx="0.8" dy="0.3" layer="1" roundness="50" stop="no" thermals="no" cream="no"/>
<smd name="2" x="-1.5" y="-0.5" dx="0.8" dy="0.3" layer="1" roundness="100"/>
<smd name="3" x="1.5" y="0" dx="0.8" dy="0.3" layer="1" rot="R90"/>
<smd name="EP" x="0" y="0" dx="1.6" dy="1.6" layer="1" cream="no"/>
<smd name="B1" x="0" y="1.4" dx="0.5" dy="0.5" layer="16"/>
<wire x1="-2" y1="2" x2="2" y2="2" width="0.15" layer="21"/>
<wire x1="-2" y1="-2" x2="2" y2="-2" width="0.1" layer="51" curve="90"/>
<circle x="-2.2" y="1.6" radius="0" width="0.25" layer="21"/>
<rectangle x1="-0.6" y1="-0.6" x2="0.6" y2="0.6" layer="31"/>
<rectangle x1="-0.9" y1="-0.9" x2="0.9" y2="0.9" layer="29"/>
<rectangle x1="-2.5" y1="-2.5" x2="2.5" y2="2.5" layer="39"/>
<rectangle x1="-0.3" y1="-2.4" x2="0.3" y2="-1.8" layer="41"/>
<polygon width="0.1" layer="1">
<vertex x="1" y="1"/>
<vertex x="1.8" y="1"/>
<vertex x="1.8" y="1.8"/>
</polygon>
<text x="-2" y="2.5" size="0.8" layer="25" font="vector" ratio="12">&gt;NAME</text>
<text x="-2" y="-3" size="0.8" layer="27">&gt;VALUE</text>
<text x="0" y="-3.5" size="0.5" layer="51" rot="R90" align="center">DOC</text>
<hole x="2.2" y="-1.5" drill="0.6"/>
</package>
<package name="TH-CENSUS" urn="urn:adsk.eagle:footprint:900004/1">
<pad name="1" x="-2.54" y="0" drill="0.9" diameter="1.2" shape="square" first="yes" thermals="no" stop="no"/>
<pad name="2" x="0" y="0" drill="0.9" shape="long" rot="R90"/>
<pad name="3" x="2.54" y="0" drill="0.9" diameter="1.6" shape="offset"/>
<pad name="4" x="5.08" y="0" drill="0.9" diameter="1.6" shape="octagon"/>
<pad name="5" x="7.62" y="0" drill="1"/>
<wire x1="-3.8" y1="1.5" x2="8.9" y2="1.5" width="0.15" layer="21"/>
<text x="-3.8" y="2" size="1" layer="25">&gt;NAME</text>
</package>
</packages>
<packages3d>
<package3d name="QFN-CENSUS" urn="urn:adsk.eagle:package:900003/1" type="box" library_version="3">
<description>Census 3D body.</description>
<packageinstances>
<packageinstance name="QFN-CENSUS"/>
</packageinstances>
</package3d>
</packages3d>
</library>
</libraries>
<attributes>
<attribute name="AUTHOR" value="Census"/>
<attribute name="REVISION" value="B"/>
</attributes>
<variantdefs>
<variantdef name="LITE"/>
<variantdef name="FULL" current="yes"/>
</variantdefs>
<classes>
<class number="0" name="default" width="0.2" drill="0.3">
<clearance class="0" value="0.2"/>
</class>
<class number="1" name="power" width="0.5" drill="0.4">
<clearance class="0" value="0.35"/>
<clearance class="1" value="0.3"/>
</class>
</classes>
<designrules name="census-rules">
<description language="en">Census design rules.</description>
<param name="layerSetup" value="(1*2*15*16)"/>
<param name="mtCopper" value="0.035mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.0175mm 0.035mm"/>
<param name="mtIsolate" value="0.2mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 0.15mm 1.2mm"/>
<param name="mdWireWire" value="7mil"/>
<param name="mdWirePad" value="8mil"/>
<param name="mdWireVia" value="8mil"/>
<param name="mdPadPad" value="9mil"/>
<param name="mdPadVia" value="8mil"/>
<param name="mdViaVia" value="8mil"/>
<param name="mdSmdPad" value="6mil"/>
<param name="mdSmdVia" value="8mil"/>
<param name="mdSmdSmd" value="6mil"/>
<param name="mdViaViaSameLayer" value="8mil"/>
<param name="mnLayersViaInSmd" value="2"/>
<param name="mdCopperDimension" value="15mil"/>
<param name="mdDrill" value="10mil"/>
<param name="mdSmdStop" value="0mil"/>
<param name="msWidth" value="6mil"/>
<param name="msDrill" value="12mil"/>
<param name="msMicroVia" value="9.99mm"/>
<param name="msBlindViaRatio" value="0.5"/>
<param name="rvPadTop" value="0.25"/>
<param name="rvPadInner" value="0.25"/>
<param name="rvPadBottom" value="0.35"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rvViaInner" value="0.3"/>
<param name="rlMinPadTop" value="12mil"/>
<param name="rlMaxPadTop" value="20mil"/>
<param name="rlMinPadInner" value="10mil"/>
<param name="rlMaxPadInner" value="20mil"/>
<param name="rlMinPadBottom" value="14mil"/>
<param name="rlMaxPadBottom" value="20mil"/>
<param name="rlMinViaOuter" value="7mil"/>
<param name="rlMaxViaOuter" value="20mil"/>
<param name="rlMinViaInner" value="9mil"/>
<param name="rlMaxViaInner" value="20mil"/>
<param name="psElongationLong" value="80"/>
<param name="psElongationOffset" value="70"/>
<param name="mvStopFrame" value="1"/>
<param name="mvCreamFrame" value="0"/>
<param name="mlMinStopFrame" value="3mil"/>
<param name="mlMaxStopFrame" value="3mil"/>
<param name="mlMinCreamFrame" value="1mil"/>
<param name="mlMaxCreamFrame" value="1mil"/>
<param name="mlViaStopLimit" value="14mil"/>
<param name="slThermalIsolate" value="12mil"/>
<param name="slThermalsForVias" value="1"/>
<param name="dpMaxLengthDifference" value="10mm"/>
<param name="dpGapFactor" value="2.5"/>
<param name="checkAngle" value="1"/>
<param name="checkRestrict" value="1"/>
<param name="maxErrors" value="50"/>
</designrules>
<autorouter>
<pass name="Default">
<param name="RoutingGrid" value="25mil"/>
<param name="cfVia" value="12"/>
</pass>
</autorouter>
<elements>
<element name="U1" library="census-lib" library_urn="urn:adsk.eagle:library:900001" package="QFN-CENSUS" package3d_urn="urn:adsk.eagle:package:900003/1" value="CS-100" x="12" y="15" rot="R30" locked="yes" smashed="yes">
<attribute name="NAME" x="10" y="19" size="1.2" layer="25" font="vector" ratio="12" rot="R30" align="bottom-left"/>
<attribute name="VALUE" x="10" y="11" size="1" layer="27" rot="R30" display="both"/>
<attribute name="MPN" value="CS-100-QFN" x="10" y="9" size="0.8" layer="51" display="off"/>
<attribute name="TOLERANCE" value="1%" constant="no"/>
<variant name="LITE" populate="no"/>
<variant name="FULL" value="CS-101"/>
