<wire x1="26" y1="24" x2="28" y2="22" width="0" layer="19"/>
<via x="10" y="24" extent="1-16" drill="0.4" shape="square" alwaysstop="yes"/>
<via x="20" y="24" extent="1-16" drill="0.3" diameter="0.5"/>
<polygon width="0.3" layer="15" isolate="0.4" orphans="yes" thermals="no" rank="2" pour="hatch" spacing="0.8">
<vertex x="2" y="2"/>
<vertex x="38" y="2"/>
<vertex x="38" y="12" curve="40"/>
<vertex x="2" y="12"/>
</polygon>
</signal>
