</elements>
<signals>
<signal name="VCC" class="1">
<contactref element="U1" pad="1"/>
<contactref element="U2" pad="1"/>
<contactref element="J1" pad="1" route="any" routetag="T1"/>
<wire x1="10" y1="17" x2="10" y2="24" width="0.5" layer="1"/>
<wire x1="10" y1="24" x2="20" y2="24" width="0.5" layer="16" curve="30"/>
