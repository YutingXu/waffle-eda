    "item": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "wire",
                  "track",
                  "graphic",
                  "polygon",
                  "bus"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "points"
            ],
            "properties": {
              "points": {
                "minItems": 2
              }
            }
          },
          "else": {}
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "part",
                  "label",
                  "netlabel",
                  "junction",
                  "via",
                  "pad",
                  "power",
                  "port",
                  "offsheet",
                  "sheetsymbol",
                  "busentry",
                  "noerc",
                  "textframe",
                  "image"
                ]
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "imageMarkup"
              }
            }
          },
          "then": {
            "required": [
              "imageId",
              "shape",
              "at",
              "to",
              "width",
              "colour"
            ],
            "properties": {
              "imageId": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "enum": [
                  "arrow",
                  "ellipse",
                  "box",
                  "highlight",
                  "text"
                ]
              },
              "at": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "to": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "colour": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "polygon"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "points": {
                "minItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "textframe"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "w",
              "h",
              "text"
            ],
            "properties": {
              "role": {
                "type": "string",
                "maxLength": 64,
                "examples": [
                  "frame"
                ]
              }
            },
            "if": {
              "properties": {
                "role": {
                  "const": "frame"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 100000000.0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 100000000.0
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S",
                  "maxLength": 300
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "netlabel"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "autoName": {
                "type": "object",
                "required": [
                  "part",
                  "pin",
                  "style"
                ],
                "properties": {
                  "part": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "pin": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "style": {
                    "type": "string",
                    "pattern": "\\S",
                    "maxLength": 64,
                    "examples": [
                      "hyphen",
                      "underscore"
                    ]
                  }
                },
                "description": "Generated net name based on a connected part ID and pin number in the current channel. The label text is its fallback."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "offsheet"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "io": {
                "type": "string",
                "maxLength": 64,
                "examples": [
                  "unspecified",
                  "input",
                  "output",
                  "bidirectional"
                ],
                "description": "Connector I/O direction. Omission means unspecified."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "textframe"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "math": {
                "type": "boolean",
                "description": "Display the TeX source in text as a non-electrical equation."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "textframe"
              },
              "math": {
                "const": true
              }
            },
            "required": [
              "kind",
              "math"
            ]
          },
          "then": {
            "required": [
              "text",
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "role": {
                "not": {
                  "const": "frame"
                }
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 100000000.0
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "part"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "def",
              "ref",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "label",
                  "netlabel"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pad"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "w",
              "h"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "via"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "diameter"
            ]
          }
        }
